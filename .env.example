# One env file for the whole monorepo (both apps read it).
# `pnpm bootstrap` copies this to .env and fills in the Supabase values from your local stack,
# so the only thing you add by hand is an AI provider key.
#
# The defaults run entirely on free OpenRouter models: create a key at https://openrouter.ai/keys and
# paste it into both AI_*_API_KEY lines. Recipes for other providers are at the bottom.

# ── Supabase ─────────────────────────────────────────────────────────────────────────────────────
# Filled automatically by `pnpm bootstrap` (from `supabase status`).
SUPABASE_URL=http://127.0.0.1:54321
# Publishable key (the legacy anon key works too). The apps never need the secret / service-role key.
SUPABASE_PUBLISHABLE_KEY=

# ── Apps ─────────────────────────────────────────────────────────────────────────────────────────
API_PORT=4000
# Where the browser reaches the API.
API_URL=http://localhost:4000
# Origin allowed by the API's CORS policy.
WEB_ORIGIN=http://localhost:3000

# ── AI: chat model ───────────────────────────────────────────────────────────────────────────────
# Any server implementing the OpenAI Chat Completions API. A preset only fills in the base URL:
#   openai | groq | together | openrouter | ollama | custom
AI_CHAT_PROVIDER=openrouter
# Optional with a preset (overrides its URL), required with `custom`, e.g. http://localhost:4001/v1
AI_CHAT_BASE_URL=
# Required for hosted presets; not needed for ollama.
AI_CHAT_API_KEY=
AI_CHAT_MODEL=google/gemma-4-31b-it:free
# Optional. Left out of requests when empty, because some models (e.g. reasoning models) reject it.
AI_CHAT_TEMPERATURE=

# ── AI: embedding model ──────────────────────────────────────────────────────────────────────────
# Configured separately from chat: not every provider serves embeddings (Groq doesn't).
AI_EMBED_PROVIDER=openrouter
AI_EMBED_BASE_URL=
AI_EMBED_API_KEY=
AI_EMBED_MODEL=liquid/lfm-2.5-embedding-350m:free
# Must match the vector(1024) column in supabase/migrations. Checked on every embedding response.
AI_EMBED_DIMENSIONS=1024
# true for models that can shorten their vectors (OpenAI text-embedding-3-*): sends `dimensions`.
AI_EMBED_SEND_DIMENSIONS=false
# Task prefixes for asymmetric models; LFM2.5-Embedding was trained with these and degrades without them.
AI_EMBED_QUERY_PREFIX="query: "
AI_EMBED_DOCUMENT_PREFIX="document: "
# Inputs per embeddings request.
AI_EMBED_BATCH_SIZE=64

# ── Retrieval ────────────────────────────────────────────────────────────────────────────────────
# Chunks placed in the prompt per question.
RAG_TOP_K=6
# Drop chunks below this cosine similarity (-1 keeps all). Model-specific: calibrate before raising it.
RAG_MIN_SIMILARITY=-1

# ── Recipes (swap providers by editing only this file) ───────────────────────────────────────────
# OpenAI:
#   AI_CHAT_PROVIDER=openai   AI_CHAT_MODEL=gpt-4o-mini
#   AI_EMBED_PROVIDER=openai  AI_EMBED_MODEL=text-embedding-3-small  AI_EMBED_SEND_DIMENSIONS=true
#   AI_EMBED_QUERY_PREFIX=    AI_EMBED_DOCUMENT_PREFIX=
# Groq for chat (it has no embeddings; keep another embedding provider):
#   AI_CHAT_PROVIDER=groq     AI_CHAT_MODEL=llama-3.3-70b-versatile
# Local Ollama, no key, fully offline (`ollama pull llama3.2 && ollama pull mxbai-embed-large`):
#   AI_CHAT_PROVIDER=ollama   AI_CHAT_MODEL=llama3.2
#   AI_EMBED_PROVIDER=ollama  AI_EMBED_MODEL=mxbai-embed-large
#   AI_EMBED_QUERY_PREFIX="Represent this sentence for searching relevant passages: "
#   AI_EMBED_DOCUMENT_PREFIX=
# Any other OpenAI-compatible server (LiteLLM, vLLM, LM Studio, a corporate gateway):
#   AI_CHAT_PROVIDER=custom   AI_CHAT_BASE_URL=http://localhost:8000/v1
